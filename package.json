{
  "name": "icetools",
  "productName": "IceTools",
  "version": "0.1.0",
  "description": "All-in-one Windows optimizer desktop app",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "node electron/dev-launcher.cjs",
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:renderer\" \"npm run wait-and-start\"",
    "wait-and-start": "wait-on tcp:127.0.0.1:5173 && npm run dev:electron",
    "build:renderer": "vite build",
    "prebuild": "node electron/kill-previous-build.cjs",
    "build": "npm run build:renderer && electron-builder",
    "prepack": "node electron/kill-previous-build.cjs",
    "pack": "npm run build:renderer && electron-builder --dir",
    "prerelease": "node electron/kill-previous-build.cjs",
    "release": "npm run build:renderer && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "daisyui": "^4.12.23",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.icetools.app",
    "productName": "IceTools",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "REPLACE_WITH_GITHUB_USERNAME",
      "repo": "REPLACE_WITH_REPO_NAME"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
